<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>CrateWatch</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
      <UserSecretsId>ea46e99a-3e8e-4315-8fb1-d6bf27a63b8b</UserSecretsId>
  </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BCrypt.Net-Next" Version="4.2.1" />
        <PackageReference Include="dbup-postgresql" Version="7.0.1" />
        <PackageReference Include="EFCore.NamingConventions" Version="10.0.1" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Db\Migration\*.sql" />
        <Compile Remove="cratewatcher.Tests\**" />
        <Content Remove="cratewatcher.Tests\**" />
        <EmbeddedResource Remove="cratewatcher.Tests\**" />
        <None Remove="cratewatcher.Tests\**" />
        <InternalsVisibleTo Include="cratewatcher.Tests" />
    </ItemGroup>

</Project>
